# EXAMPLE ONLY - never commit actual secrets or credentials
APP_ENV=local
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=idps_db
DB_USERNAME=idps_app
DB_PASSWORD=replace_locally
AI_BASE_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT_SECONDS=15
FORECAST_RETRAIN_CRON=0 2 1 * *
TIMEZONE=UTC
FACILITY_TIMEZONE=Africa/Tripoli
STORAGE_DRIVER=local
DATA_ENCRYPTION_KEY=replace_locally

# MySQL 8.4 LTS in UTC with utf8mb4
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
